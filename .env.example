# Same Supabase project as Docket Flow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the cockpit links to review an intake and promote it to a case.
NEXT_PUBLIC_DOCKET_URL=https://rjl-docket-flow.vercel.app

# Used as the Google OAuth redirect origin in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Slack app that reads #lead-calls. The request URL is /api/slack/events.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
SLACK_LEAD_CHANNEL_ID=C026G89PPSS

# Protects /api/cron/queues. Send Authorization: Bearer <secret>.
CRON_SECRET=

# Texts stay queued until this is live, so this app does not double-text SMS Follow-Up.
TEXT_SENDING=off
QUO_API_KEY=
QUO_FROM_NUMBER=
QUO_API_BASE=https://api.quo.com/v1

# Tags are stored on the lead either way. These push them onto the CallRail call.
CALLRAIL_API_KEY=
CALLRAIL_ACCOUNT_ID=
